@echo off
chcp 65001 > nul
title EGX Investor Tracker - البورصة المصرية
cd /d "%~dp0"
echo ========================================================
echo   تشغيل لوحة تحكم تعاملات فئات المستثمرين وأسعار تعويم
echo ========================================================
echo.

:: إغلاق أي نسخة سابقة تعمل على المنفذ 5050 تلقائياً
echo فحص وإغلاق أي نسخة قديمة قيد التشغيل...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr /R ":5050 .*LISTENING"') do (
    taskkill /F /PID %%a >nul 2>&1
)

echo بدء تشغيل الخادم بالتحديثات الجديدة...
start "" "http://127.0.0.1:5050"
python app.py
pause
